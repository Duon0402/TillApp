<Window x:Class="TillApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TillApp" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#1F2937">
            <TextBlock Text="TillApp" Foreground="White" FontSize="20"
                       Margin="16,20,16,20" FontWeight="Bold"/>

            <Button Content="Bán hàng" Margin="8,4" Command="{Binding NavigateToSalesCommand}"/>
            <Button Content="Sản phẩm" Margin="8,4" Command="{Binding NavigateToProductsCommand}"/>
            <Button Content="Báo cáo" Margin="8,4"/>
        </StackPanel>


        <ContentControl Grid.Column="1" 
                        Content="{Binding Navigation.CurrentViewModel}"/>
    </Grid>
</Window>
