<UserControl x:Class="TillApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
        <TextBlock Text="Cấu hình cửa hàng" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Text="Tên cửa hàng"/>
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>

        <TextBlock Text="Địa chỉ"/>
        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>

        <TextBlock Text="Số điện thoại"/>
        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>

        <TextBlock Text="Mã số thuế"/>
        <TextBox Text="{Binding TaxCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>

        <TextBlock Text="Đường dẫn logo (tùy chọn)"/>
        <TextBox Text="{Binding LogoPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>

        <Button Content="Lưu" Command="{Binding SaveCommand}" Margin="0,8,0,8"/>

        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="Green" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
