<UserControl x:Class="TillApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">

    <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
        <StackPanel>
            <TextBlock Text="Cấu hình cửa hàng" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="Tên cửa hàng" Style="{StaticResource FieldLabelStyle}"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

            <TextBlock Text="Địa chỉ" Style="{StaticResource FieldLabelStyle}"/>
            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

            <TextBlock Text="Số điện thoại" Style="{StaticResource FieldLabelStyle}"/>
            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

            <TextBlock Text="Mã số thuế" Style="{StaticResource FieldLabelStyle}"/>
            <TextBox Text="{Binding TaxCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

            <TextBlock Text="Đường dẫn logo (tùy chọn)" Style="{StaticResource FieldLabelStyle}"/>
            <TextBox Text="{Binding LogoPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18"/>

            <Button Content="Lưu" Command="{Binding SaveCommand}"/>

            <TextBlock Text="{Binding StatusMessage}" Margin="0,12,0,0"
                       Foreground="#16A34A" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</UserControl>
